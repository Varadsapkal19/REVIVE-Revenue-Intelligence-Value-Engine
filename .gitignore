# ============================================================
# REVIVE .gitignore
# ============================================================

# ── Secrets ──────────────────────────────────────────────────
.env
.env.local
.env.production
*.pem
*.key

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.venv/
venv/
env/
ENV/

# ── ML Models (large binary files) ───────────────────────────
ml/models/*.pkl
ml/models/*.joblib
ml/models/*.bin
ml/datasets/raw/

# ── Node / Next.js ───────────────────────────────────────────
node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo

# ── Docker volumes ───────────────────────────────────────────
postgres_data/
redis_data/

# ── IDE ───────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── Test / Coverage ──────────────────────────────────────────
.coverage
htmlcov/
.pytest_cache/
coverage/
*.lcov

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/
