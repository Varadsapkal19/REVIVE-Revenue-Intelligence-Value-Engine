# ============================================================
# REVIVE — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Application ─────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
APP_DEBUG=true

# ── Database ─────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=revive
POSTGRES_USER=revive_user
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql://revive_user:change-this-strong-password@postgres:5432/revive

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Razorpay Test Mode (optional — simulator works without these) ──
# Get your test keys from: https://dashboard.razorpay.com → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_REPLACE_WITH_YOUR_KEY
RAZORPAY_KEY_SECRET=REPLACE_WITH_YOUR_SECRET
RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_YOUR_WEBHOOK_SECRET

# ── Ollama / LLM (optional — system degrades gracefully without it) ──
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
LLM_ENABLED=true

# ── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_ENV=development

# ── CORS ─────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
